# ---------------------------------------------------------------------------
# Tessera backend configuration. Copy this file to `backend/.env`.
# `backend/.env` is gitignored. NEVER commit real keys or paste them into chat.
# ---------------------------------------------------------------------------

# Nebius Token Factory (OpenAI-compatible chat completions API).
# Get the base URL and the exact model id from your Nebius Token Factory
# dashboard / documentation. These values are intentionally NOT guessed here.
# Example shape only (verify against your dashboard): an OpenAI-compatible
# endpoint usually ends in /v1 and the model id looks like an organisation/model
# slug.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=

# Optional: only set this if your account actually offers an embeddings model.
# Leave empty to use the built-in lexical (BM25) retrieval, which needs no
# external service and is the default.
NEBIUS_EMBEDDING_MODEL=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Upload / processing limits
MAX_UPLOAD_MB=25
MAX_FILES_PER_SESSION=20
MAX_PAGES_PER_PDF=400

# LLM behaviour
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=3
LLM_MAX_PROMPT_CHARS=24000

# Storage directory (relative to backend/ unless absolute)
DATA_DIR=data
