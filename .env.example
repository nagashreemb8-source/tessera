# ---------------------------------------------------------------------------
# Frontend configuration. Copy to `.env` at the project root.
#
# Leave VITE_API_BASE_URL empty to run in demo mode: the sample subject, the
# local engine and hand-written explanations. No network, no model.
#
# Set it to your local backend to turn on AI mode, e.g.
#   VITE_API_BASE_URL=http://localhost:8000
# The browser then calls only that backend (see backend/README.md).
#
# Never put API keys in this file or in any file prefixed with VITE_:
# Vite exposes VITE_* values to the browser. Keys live in backend/.env only.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
